MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=notifications

# Обязан совпадать с JWT_SECRET auth-service — иначе токены не пройдут проверку
JWT_SECRET=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

MAIL_HOST=127.0.0.1
MAIL_PORT=1025

# Тот же Redis, что и у auth-service — используется только на чтение (blacklist отозванных токенов)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:8082
