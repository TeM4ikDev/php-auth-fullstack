{
    "require": {
        "php": "^8.5",
        "ext-mongodb": "*",
        "ext-json": "*",
        "mongodb/mongodb": "^2.0",
        "phpmailer/phpmailer": "^6.9",
        "php-amqplib/php-amqplib": "^3.7",
        "firebase/php-jwt": "^7.0",
        "predis/predis": "^2.2"
    },
    "scripts": {
        "serve": "php -S localhost:8001 -t public public/index.php",
        "consume": "php consume.php",
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0
    }
}
