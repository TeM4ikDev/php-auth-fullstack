POSTGRES_DB=php_auth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

DB_HOST=localhost
DB_PORT=45432

# Сгенерировать: openssl rand -hex 32. Обязателен — приложение не стартует без него.
JWT_SECRET=
JWT_TTL=86400

# Первый администратор, создаётся скриптом composer seed
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Ссылка на клиент — подставляется в письмо подтверждения email
CLIENT_URL=http://localhost:8081

# RabbitMQ — общий брокер для auth-service (publisher) и notification-service (consumer)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# MongoDB — база истории уведомлений notification-service
MONGO_DATABASE=notifications
