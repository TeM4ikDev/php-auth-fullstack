{
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-json": "*",
        "phpmailer/phpmailer": "^6.9",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "migrate": "php migrate.php",
        "seed": "php seed.php",
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0
    }
}
